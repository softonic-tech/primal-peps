{
  "version": 2,
  "builds": [
    {
      "src": "api/signup.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/signup",
      "methods": ["POST", "OPTIONS"],
      "dest": "/api/signup.cjs"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
